# DEKEN STUDIO AI — variables de entorno de desarrollo.
# Copia este fichero a infra/.env y CAMBIA todos los secretos:
#   openssl rand -base64 48   (DEKEN_SECRET_KEY)
#   openssl rand -hex 24      (contraseñas y claves S3)
# Nunca subas infra/.env al repositorio (está en .gitignore).

DEKEN_ENVIRONMENT=development
DEKEN_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-48-bytes-minimo

POSTGRES_USER=deken
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=deken
POSTGRES_PORT=5432

REDIS_PASSWORD=cambia-esto
REDIS_PORT=6379

S3_ACCESS_KEY=cambia-esto
S3_SECRET_KEY=cambia-esto-tambien
S3_BUCKET=deken-studio
S3_PORT=8333
# URL con la que el NAVEGADOR descarga ficheros (URLs firmadas).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
# URL con la que los WORKERS suben/descargan. En un worker WSL2 remoto será la URL
# pública HTTPS del almacenamiento.
S3_WORKER_ENDPOINT_URL=http://seaweedfs:8333
S3_ALLOWED_ORIGINS=http://localhost:3000

DEKEN_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=8000
WEB_PORT=3000

# Proveedor de IA (Sprint 2). Vacío = modo manual, la interfaz lo indica.
DEKEN_AI_PROVIDER=
DEKEN_AI_API_KEY=
DEKEN_AI_MODEL=

# Token del worker en contenedor (perfil "worker"): créalo en Configuración → Workers.
DEKEN_WORKER_TOKEN=

# Remotion (motor de composición). Mientras Grupo Deken no verifique la licencia de
# empresa, solo se permiten renders de EVALUACIÓN (ver docs/adr/0005-remotion-composition-engine.md).
DEKEN_REMOTION_LICENSE_MODE=evaluation
# Solo en los workers, nunca en la API ni en la web:
DEKEN_REMOTION_LICENSE_KEY=
# Navegador para Remotion (opcional). Vacío = el que instala `make remotion` en
# workers/render/remotion/node_modules/.remotion (en la imagen del worker ya va incluido).
DEKEN_REMOTION_BROWSER=
